{
  "name": "pocket-for-vikunja",
  "version": "0.0.0-dev",
  "private": true,
  "license": "MIT",
  "description": "A mobile web app for tasks and checklists in Vikunja, served by Vikunja itself.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "eslint . && node scripts/check.mjs",
    "dev": "node scripts/dev.mjs",
    "test": "npm run test:unit && node tests/parse.mjs && node tests/smoke.mjs && node tests/checklists.mjs",
    "test:unit": "node --test --test-reporter=spec \"tests/unit/*.test.mjs\"",
    "test:parse": "node tests/parse.mjs",
    "test:smoke": "node tests/smoke.mjs",
    "test:checklists": "node tests/checklists.mjs",
    "test:steptimes": "node tests/steptimes.mjs",
    "test:local": "node scripts/dev.mjs --test",
    "demo": "node scripts/demo.mjs",
    "specimen": "node scripts/specimen.mjs",
    "perf": "node scripts/perf/app-bench.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "gifenc": "^1.0.3",
    "globals": "^17.13.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0"
  }
}
